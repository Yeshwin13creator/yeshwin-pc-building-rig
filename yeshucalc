      <div class="build-body">
        <table class="comp-table"><thead><tr><th>Component</th><th>Model</th><th>Price</th></tr></thead><tbody>${rows}</tbody></table>
        <div class="bn-indicator ${warn ? 'warn' : ''}">
          <span class="bn-icon">${warn ? '⚠️' : '✅'}</span>
