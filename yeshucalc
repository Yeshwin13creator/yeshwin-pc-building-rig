function toggleSearch() {
  const box = document.getElementById('searchBox');
  box.classList.toggle('open');
  if (box.classList.contains('open')) {
    document.getElementById('searchInput').focus();
    document.getElementById('searchInput').value = '';
    document.getElementById('searchResults').innerHTML = '';
  }
}
document.addEventListener('click', e => {
  const sw = document.querySelector('.search-wrap');
  if (!sw.contains(e.target)) document.getElementById('searchBox').classList.remove('open');
});

function doSearch(q) {
  const res = document.getElementById('searchResults');
  q = q.trim().toLowerCase();
  if (!q) { res.innerHTML = ''; return; }
  let results = [];
  cpus.filter(c => c.name.toLowerCase().includes(q)).slice(0,4).forEach(c => {
    results.push(`<div class="search-result" onclick="goToBN('cpu','${c.id}')"><span class="search-result-badge badge-cpu">CPU</span>${c.name} <span style="color:var(--muted);font-size:11px">${c.brand} · ${c.series}</span></div>`);
  });
  gpus.filter(g => g.name.toLowerCase().includes(q)).slice(0,4).forEach(g => {
    results.push(`<div class="search-result" onclick="goToBN('gpu','${g.id}')"><span class="search-result-badge badge-gpu">GPU</span>${g.name} <span style="color:var(--muted);font-size:11px">${g.brand} · ${g.series}</span></div>`);
  });
  builds.filter(b => b.name.toLowerCase().replace(/&#\d+;/g,'').includes(q)).slice(0,3).forEach(b => {
    results.push(`<div class="search-result" onclick="goToBuilder(${b.min})"><span class="search-result-badge badge-build">Build</span>${b.name.replace(/&#\d+;/g,'₹')}</div>`);
  });
  res.innerHTML = results.length ? results.join('') : '<div class="no-results">No results found</div>';
}

function goToBN(type, id) {
  showPage('bottleneck');
  document.getElementById('searchBox').classList.remove('open');
  setTimeout(() => {
    if (type === 'cpu') { selCpuId = id; updateComboDisplay('cpu', id); }
    else { selGpuId = id; updateComboDisplay('gpu', id); }
  }, 100);
}

function goToBuilder(budgetVal) {
  showPage('builder');
  document.getElementById('searchBox').classList.remove('open');
  const slider = document.getElementById('budgetSlider');
  slider.value = budgetVal;
  onBudget(budgetVal);
}

