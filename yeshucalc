      <div class="stat-name" style="width:150px">${g}</div>
      <div class="stat-bars">
        <div class="stat-bar-wrap"><div class="stat-bar-bg"><div class="stat-bar-fill a" style="width:${aW}%"></div></div><span class="stat-val" style="width:55px">${af} FPS</span></div>
        <div class="stat-bar-wrap"><div class="stat-bar-bg"><div class="stat-bar-fill b" style="width:${bW}%"></div></div><span class="stat-val" style="width:55px">${bf} FPS</span></div>
      </div></div>`;
  }).join('');
  document.getElementById('buildCompareResult').innerHTML = `<div class="compare-result fade-in">
    <h3><span style="color:var(--blue)">${buildA.name.replace(/&#\d+;/g,'₹')}</span> vs <span style="color:var(--purple)">${buildB.name.replace(/&#\d+;/g,'₹')}</span> — 1080p FPS</h3>
    <div style="display:flex;gap:16px;margin-bottom:14px;font-size:12px;flex-wrap:wrap">
      <span style="display:flex;align-items:center;gap:6px"><span style="width:12px;height:12px;background:var(--blue);border-radius:2px;display:inline-block"></span>${buildA.name.replace(/&#\d+;/g,'₹')} (&#8377;${buildA.price.toLocaleString('en-IN')})</span>
      <span style="display:flex;align-items:center;gap:6px"><span style="width:12px;height:12px;background:var(--purple);border-radius:2px;display:inline-block"></span>${buildB.name.replace(/&#\d+;/g,'₹')} (&#8377;${buildB.price.toLocaleString('en-IN')})</span>
    </div>
    ${rows}
    <div style="margin-top:16px;padding:12px;background:rgba(59,130,246,.08);border:1px solid var(--border);border-radius:10px;font-size:13px;color:var(--text2)">
      Price difference: <strong style="color:var(--text)">&#8377;${Math.abs(buildB.price-buildA.price).toLocaleString('en-IN')}</strong> — the ${buildB.price>buildA.price?buildB.name.replace(/&#\d+;/g,'₹'):buildA.name.replace(/&#\d+;/g,'₹')} is more expensive.
    </div>
  </div>`;
}

