    <div class="spec-box"><h4 style="color:var(--blue)">${a.name}</h4>
      ${specRow('Cores/Threads',a.cores+'/'+a.threads)}${specRow('Base / Boost',a.base+'GHz / '+a.boost+'GHz')}${specRow('Socket',a.socket)}${specRow('TDP',a.tdp+'W')}${specRow('Benchmark',a.bench.toLocaleString())}
