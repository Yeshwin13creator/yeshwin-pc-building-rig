function getBestBuild(b) {
  let best = builds[0];
  for (const bd of builds) {
    if (b >= bd.min && b <= bd.max) { best = bd; break; }
    if (b > bd.max) best = bd;
  }
  return best;
}

function fpsClass(f) {
  if (f >= 144) return 'excellent';
  if (f >= 60) return 'good';
  if (f >= 30) return 'ok';
  return 'low';
}

function generateBuild() {
