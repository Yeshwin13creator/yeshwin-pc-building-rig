let cmpCpu1 = null, cmpCpu2 = null, cmpGpu1 = null, cmpGpu2 = null;

function compareCPUs() {
  if (!cmpCpu1 || !cmpCpu2) { alert('Select two CPUs to compare.'); return; }
  const a = cpus.find(c => c.id === cmpCpu1);
  const b = cpus.find(c => c.id === cmpCpu2);
  const cats = [
    {label:'Gaming Score',aVal:a.gaming,bVal:b.gaming,max:100},
    {label:'Productivity',aVal:a.prod,bVal:b.prod,max:100},
    {label:'Value Score',aVal:a.value,bVal:b.value,max:100},
    {label:'Power Efficiency',aVal:Math.round(a.gaming/a.tdp*100)/10,bVal:Math.round(b.gaming/b.tdp*100)/10,max:5}
  ];
  let bars = cats.map(cat => {
    const aw = (cat.aVal/cat.max)*100, bw = (cat.bVal/cat.max)*100;
    const winner = cat.aVal > cat.bVal ? a.name : cat.bVal > cat.aVal ? b.name : 'Tie';
