    <div class="build-card-result fade-in">
      <div class="build-head">
        <div class="build-title-row">
          <div><div class="build-name-big">${bd.name.replace(/&#\d+;/g,'₹')}</div><span class="tier-badge">${bd.tier}</span></div>
          <div style="text-align:right"><div class="build-price-big">&#8377;${bd.price.toLocaleString('en-IN')}</div><div style="color:var(--muted);font-size:12px">≈ $${usd.toLocaleString()} USD</div></div>
