function buildCombobox(containerId, data, idField, nameField, seriesField, brandField, onSelect, filterFn) {
  const container = document.getElementById(containerId);
  const groups = {};
  data.forEach(item => {
    const key = item[brandField] + ' — ' + item[seriesField];
    if (!groups[key]) groups[key] = [];
    groups[key].push(item);
  });
  const displayEl = document.createElement('div');
  displayEl.className = 'combobox-input';
  displayEl.style.cursor = 'pointer';
  displayEl.textContent = 'Choose...';
  const dropdown = document.createElement('div');
  dropdown.className = 'combobox-dropdown';
  const searchWrap = document.createElement('div');
  searchWrap.className = 'combo-search';
  const searchInp = document.createElement('input');
  searchInp.placeholder = 'Search...';
  searchWrap.appendChild(searchInp);
  dropdown.appendChild(searchWrap);
  const listEl = document.createElement('div');
  dropdown.appendChild(listEl);
  function render(q) {
    listEl.innerHTML = '';
    const qLow = q.toLowerCase();
    for (const [grp, items] of Object.entries(groups)) {
      const filtered = items.filter(i => !q || i[nameField].toLowerCase().includes(qLow));
      if (!filtered.length) continue;
      const gl = document.createElement('div');
      gl.className = 'combo-group-label';
      gl.textContent = grp;
      listEl.appendChild(gl);
      filtered.forEach(item => {
        const opt = document.createElement('div');
        opt.className = 'combo-option';
        opt.textContent = item[nameField];
        opt.onclick = () => {
          displayEl.textContent = item[nameField];
          dropdown.classList.remove('open');
          onSelect(item[idField]);
        };
        listEl.appendChild(opt);
      });
    }
  }
  render('');
  searchInp.oninput = () => render(searchInp.value);
  displayEl.onclick = (e) => { e.stopPropagation(); dropdown.classList.toggle('open'); if(dropdown.classList.contains('open')) searchInp.focus(); };
  document.addEventListener('click', e => { if (!container.contains(e.target)) dropdown.classList.remove('open'); });
  const wrap = document.createElement('div');
  wrap.className = 'combobox-wrap';
  wrap.appendChild(displayEl);
  wrap.appendChild(dropdown);
  container.appendChild(wrap);
  container._displayEl = displayEl;
  container._render = render;
}

function updateComboDisplay(type, id) {
  if (type === 'cpu') {
    const c = cpus.find(x => x.id === id);
    if (c) { const el = document.querySelector('#cpuCombo .combobox-input'); if(el) el.textContent = c.name; }
  } else {
    const g = gpus.find(x => x.id === id);
    if (g) { const el = document.querySelector('#gpuCombo .combobox-input'); if(el) el.textContent = g.name; }
  }
}

// ═══════════════════════════════════════════════════════
// BOTTLENECK ENGINE
// ═══════════════════════════════════════════════════════
const resWeights = {'1080p':0.55,'1440p':0.65,'4k':0.80,'ultrawide':0.72};

function calcBN(cpuScore, gpuScore, mode, res) {
  const gpuW = mode === 'gaming' ? resWeights[res] : 0.35;
  const cpuW = 1 - gpuW;
  let pct, source, cpuUtil, gpuUtil;
  if (cpuScore < gpuScore) {
    const diff = gpuScore - cpuScore;
    pct = Math.min(Math.round((diff / gpuScore) * 100 * gpuW), 60);
    source = 'CPU';
    cpuUtil = 100;
    gpuUtil = Math.max(40, 100 - pct);
  } else if (gpuScore < cpuScore) {
    const diff = cpuScore - gpuScore;
    pct = Math.min(Math.round((diff / cpuScore) * 100 * cpuW), 60);
    source = 'GPU';
    gpuUtil = 100;
    cpuUtil = Math.max(40, 100 - pct);
  } else {
    pct = 0; source = 'Balanced'; cpuUtil = 95; gpuUtil = 95;
  }
  return { pct, source, cpuUtil, gpuUtil };
}

function setMode(el, m) {
  document.querySelectorAll('.mode-btn').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  calcMode = m;
}

function setRes(el, r) {
  document.querySelectorAll('.res-tab').forEach(b => b.classList.remove('active'));
  el.classList.add('active');
  calcRes = r;
}

function calcBottleneck() {
  if (!selCpuId || !selGpuId) { alert('Please select both a CPU and GPU.'); return; }
  const cpu = cpus.find(c => c.id === selCpuId);
  const gpu = gpus.find(g => g.id === selGpuId);
  if (!cpu || !gpu) return;
  const cpuScore = calcMode === 'gaming' ? cpu.gaming : cpu.prod;
  const gpuScore = gpu.gaming;
  const bn = calcBN(cpuScore, gpuScore, calcMode, calcRes);
  // Meter
  const circumference = 540;
  const offset = circumference - (bn.pct / 100) * circumference;
  const fill = document.getElementById('meterFill');
  fill.style.strokeDashoffset = offset;
  fill.style.stroke = bn.pct < 10 ? '#10b981' : bn.pct < 25 ? '#f59e0b' : '#ef4444';
  document.getElementById('bnPct').textContent = bn.pct + '%';
  const statusMap = {'CPU':'CPU Bottleneck','GPU':'GPU Bottleneck','Balanced':'Well Balanced'};
  document.getElementById('bnStatus').textContent = statusMap[bn.source];
  let desc = '';
  if (bn.source === 'CPU') desc = `Your ${cpu.name} is limiting your ${gpu.name} by ${bn.pct}% at ${calcRes.toUpperCase()}. Upgrading your CPU will yield better performance.`;
  else if (bn.source === 'GPU') desc = `Your ${gpu.name} is the limiting factor by ${bn.pct}% at ${calcRes.toUpperCase()}. A stronger GPU will unlock more frames.`;
  else desc = `Your ${cpu.name} and ${gpu.name} are well matched. Enjoy smooth, balanced performance!`;
  document.getElementById('bnDesc').textContent = desc;
  // Util bars
  document.getElementById('cpuUtilVal').textContent = bn.cpuUtil + '%';
  document.getElementById('gpuUtilVal').textContent = bn.gpuUtil + '%';
  document.getElementById('cpuUtilBar').style.width = bn.cpuUtil + '%';
  document.getElementById('gpuUtilBar').style.width = bn.gpuUtil + '%';
  // Res table
  const resolutions = ['1080p','1440p','4k','ultrawide'];
  const labels = {'1080p':'1080p','1440p':'1440p','4k':'4K','ultrawide':'Ultrawide'};
  let tbl = '';
  for (const r of resolutions) {
    const b2 = calcBN(cpuScore, gpuScore, calcMode, r);
    const cls = b2.pct < 10 ? 'pct-good' : b2.pct < 25 ? 'pct-ok' : 'pct-warn';
    const assess = b2.pct < 5 ? 'Balanced' : b2.pct < 15 ? 'Mild' : b2.pct < 30 ? 'Moderate' : 'Significant';
    tbl += `<tr><td>${labels[r]}</td><td class="${cls}">${b2.pct}%</td><td>${b2.source}</td><td class="${cls}">${assess}</td></tr>`;
  }
  document.getElementById('resTableBody').innerHTML = tbl;
  // Recs
  let recs = [];
  if (bn.source === 'CPU') {
    recs.push({warn:true,title:'CPU Bottleneck Detected',text:`Your ${cpu.name} is holding back your ${gpu.name}. Consider upgrading to a faster CPU to fully utilise your GPU.`});
    if (bn.pct > 20) recs.push({warn:true,title:'Significant Bottleneck',text:'At 1080p the bottleneck is especially noticeable. Move to 1440p or 4K to shift more load to the GPU and reduce CPU dependency.'});
    else recs.push({warn:false,title:'Upgrade Path',text:'A same-generation CPU with higher gaming score would reduce this bottleneck. Look for faster single-core performance.'});
  } else if (bn.source === 'GPU') {
    recs.push({warn:true,title:'GPU Bottleneck Detected',text:`Your ${gpu.name} is limiting your ${cpu.name}. Upgrading your GPU will directly improve framerates.`});
    recs.push({warn:false,title:'Good News',text:'GPU bottlenecks mean your CPU is well-suited for future GPU upgrades. The CPU platform is not holding you back.'});
  } else {
    recs.push({warn:false,title:'Well Balanced Build',text:`${cpu.name} + ${gpu.name} is an excellent pairing. Neither component is significantly limiting the other.`});
    recs.push({warn:false,title:'Upgrade Both Together',text:'When you upgrade, consider upgrading both CPU and GPU together to maintain this balance.'});
  }
  document.getElementById('recsList').innerHTML = recs.map(r => `<div class="rec-item ${r.warn?'warn':''}"><span style="font-size:18px">${r.warn?'⚠️':'✅'}</span><div class="rec-text"><strong>${r.title}</strong>${r.text}</div></div>`).join('');
  document.getElementById('bnResults').classList.add('active');
  document.getElementById('bnResults').scrollIntoView({behavior:'smooth',block:'start'});
}

