<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Yeshwin PC Builder | Build Your Perfect Gaming PC</title>
<meta name="description" content="Build the best gaming PC for your budget with Yeshwin PC Builder. Bottleneck calculator, hardware comparison, and personalized build recommendations for Indian gamers.">
<meta name="author" content="Yeshwin S">
<meta name="theme-color" content="#020617">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
  --bg:#020617;--bg2:#0f172a;--card:rgba(15,23,42,0.85);--border:rgba(59,130,246,0.2);
  --text:#f8fafc;--text2:#94a3b8;--muted:#64748b;
  --blue:#3b82f6;--purple:#8b5cf6;--cyan:#06b6d4;--green:#10b981;--yellow:#f59e0b;--red:#ef4444;
  --grad:linear-gradient(135deg,#3b82f6,#8b5cf6);
  --glow:linear-gradient(135deg,rgba(59,130,246,.15),rgba(139,92,246,.15));
}
body{font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;background:var(--bg);color:var(--text);min-height:100vh;line-height:1.6}

/* ── NAV ─────────────────────────────────────────────────────── */
nav{position:fixed;top:0;left:0;right:0;z-index:1000;background:rgba(2,6,23,.92);backdrop-filter:blur(20px);border-bottom:1px solid var(--border)}
.nav-inner{max-width:1400px;margin:0 auto;padding:0 24px;height:68px;display:flex;align-items:center;justify-content:space-between}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;cursor:pointer}
.logo{width:38px;height:38px;background:var(--grad);border-radius:10px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:16px}
.brand-name{font-size:18px;font-weight:700;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.nav-links{display:flex;gap:4px;align-items:center}
.nav-link{padding:9px 16px;border-radius:8px;text-decoration:none;color:var(--text2);font-weight:500;font-size:14px;cursor:pointer;border:none;background:none;transition:all .25s}
.nav-link:hover{color:var(--text);background:rgba(59,130,246,.1)}
.nav-link.active{background:var(--grad);color:#fff}
.ham{display:none;background:none;border:none;color:var(--text);font-size:22px;cursor:pointer;padding:4px}
.search-wrap{position:relative}
.search-toggle{background:none;border:1px solid var(--border);border-radius:8px;color:var(--text2);padding:8px 12px;cursor:pointer;font-size:13px;display:flex;align-items:center;gap:6px;transition:all .25s}
.search-toggle:hover{border-color:var(--blue);color:var(--text)}
.search-box{display:none;position:absolute;right:0;top:calc(100% + 8px);width:360px;background:var(--bg2);border:1px solid var(--border);border-radius:12px;overflow:hidden;box-shadow:0 20px 40px rgba(0,0,0,.5)}
.search-box.open{display:block}
.search-input-wrap{padding:12px;border-bottom:1px solid var(--border)}
.search-input{width:100%;background:rgba(59,130,246,.08);border:1px solid var(--border);border-radius:8px;padding:10px 14px;color:var(--text);font-size:14px;outline:none}
.search-input:focus{border-color:var(--blue)}
.search-results{max-height:300px;overflow-y:auto}
.search-result{padding:10px 14px;cursor:pointer;font-size:13px;display:flex;align-items:center;gap:10px;transition:background .15s;border-bottom:1px solid rgba(59,130,246,.08)}
.search-result:hover{background:rgba(59,130,246,.1)}
.search-result-badge{padding:2px 8px;border-radius:20px;font-size:10px;font-weight:600;text-transform:uppercase}
.badge-cpu{background:rgba(59,130,246,.2);color:var(--blue)}
.badge-gpu{background:rgba(139,92,246,.2);color:var(--purple)}
.badge-build{background:rgba(16,185,129,.2);color:var(--green)}
.no-results{padding:20px;text-align:center;color:var(--muted);font-size:13px}

/* ── PAGES ───────────────────────────────────────────────────── */
.page{display:none;padding-top:68px;min-height:100vh}
.page.active{display:block}

/* ── HERO ────────────────────────────────────────────────────── */
.hero{position:relative;padding:80px 24px 60px;text-align:center;overflow:hidden}
.hero::before{content:'';position:absolute;top:-50%;left:50%;transform:translateX(-50%);width:800px;height:800px;background:radial-gradient(circle,rgba(59,130,246,.15) 0%,transparent 70%);pointer-events:none}
.badge{display:inline-flex;align-items:center;gap:8px;padding:7px 16px;background:rgba(59,130,246,.1);border:1px solid var(--border);border-radius:50px;font-size:13px;color:var(--blue);margin-bottom:24px}
.hero h1{font-size:clamp(32px,6vw,62px);font-weight:800;line-height:1.1;margin-bottom:18px}
.grad-text{background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.hero p{font-size:17px;color:var(--text2);max-width:580px;margin:0 auto 30px}
.hero-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}

/* ── BUTTONS ─────────────────────────────────────────────────── */
.btn{display:inline-flex;align-items:center;gap:8px;padding:13px 26px;border-radius:11px;font-weight:600;font-size:14px;cursor:pointer;transition:all .25s;border:none;text-decoration:none;font-family:inherit}
.btn-primary{background:var(--grad);color:#fff;box-shadow:0 4px 20px rgba(59,130,246,.35)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 6px 28px rgba(59,130,246,.5)}
.btn-secondary{background:rgba(59,130,246,.1);color:var(--blue);border:1px solid var(--border)}
.btn-secondary:hover{background:rgba(59,130,246,.18)}
.btn-red{background:linear-gradient(135deg,#ef4444,#dc2626);color:#fff}
.btn-red:hover{transform:translateY(-2px);box-shadow:0 6px 28px rgba(239,68,68,.4)}
.btn-full{width:100%;justify-content:center;padding:15px}

/* ── CARDS GRID ──────────────────────────────────────────────── */
.section{padding:60px 24px;max-width:1400px;margin:0 auto}
.section-header{text-align:center;margin-bottom:40px}
.section-header h2{font-size:30px;font-weight:700;margin-bottom:10px}
.section-header p{color:var(--text2);font-size:15px}
.cards-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px}
.card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:26px;backdrop-filter:blur(10px);transition:all .3s}
.card:hover{border-color:rgba(59,130,246,.4);transform:translateY(-4px);box-shadow:0 20px 40px rgba(0,0,0,.3)}
.card-icon{width:46px;height:46px;background:var(--glow);border-radius:11px;display:flex;align-items:center;justify-content:center;margin-bottom:14px;font-size:22px}
.card h3{font-size:16px;font-weight:600;margin-bottom:7px}
.card p{color:var(--text2);font-size:13px}

/* ── YOUTUBE BANNER ──────────────────────────────────────────── */
.yt-banner{background:linear-gradient(135deg,rgba(239,68,68,.18),rgba(139,92,246,.18));border:1px solid rgba(239,68,68,.25);border-radius:16px;padding:30px;text-align:center;margin:36px auto;max-width:760px}
.yt-banner h3{font-size:22px;margin-bottom:10px}
.yt-banner p{color:var(--text2);margin-bottom:18px}

/* ── BUILDER ─────────────────────────────────────────────────── */
.container{max-width:1100px;margin:0 auto;padding:36px 24px}
.page-header{text-align:center;margin-bottom:36px}
.page-header h1{font-size:32px;font-weight:700;margin-bottom:10px}
.page-header p{color:var(--text2)}

.budget-card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:30px;margin-bottom:24px}
.budget-display{text-align:center;margin-bottom:20px}
.budget-amount{font-size:44px;font-weight:800;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.budget-usd{color:var(--text2);font-size:14px;margin-top:4px}
.budget-label{color:var(--muted);font-size:13px}
.slider-wrap{padding:16px 0}
.budget-slider{width:100%;height:7px;-webkit-appearance:none;appearance:none;background:linear-gradient(to right,var(--blue),var(--purple));border-radius:4px;outline:none;cursor:pointer}
.budget-slider::-webkit-slider-thumb{-webkit-appearance:none;width:26px;height:26px;background:#fff;border-radius:50%;cursor:pointer;box-shadow:0 4px 14px rgba(59,130,246,.5);transition:transform .2s}
.budget-slider::-webkit-slider-thumb:hover{transform:scale(1.1)}
.slider-labels{display:flex;justify-content:space-between;margin-top:10px;font-size:11px;color:var(--muted)}

.usecase-section{margin-bottom:24px}
.usecase-section h3{font-size:16px;font-weight:600;margin-bottom:14px;text-align:center}
.usecase-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:10px}
.usecase-btn{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:14px 10px;text-align:center;cursor:pointer;transition:all .25s;user-select:none}
.usecase-btn:hover{border-color:rgba(59,130,246,.4)}
.usecase-btn.active{border-color:var(--blue);background:rgba(59,130,246,.1);box-shadow:0 0 18px rgba(59,130,246,.2)}
.usecase-icon{font-size:26px;margin-bottom:6px}
.usecase-name{font-size:12px;font-weight:500}

.build-results{margin-top:24px}
.build-card-result{background:var(--card);border:1px solid var(--border);border-radius:20px;overflow:hidden;margin-bottom:22px}
.build-head{background:var(--glow);padding:22px 26px;border-bottom:1px solid var(--border)}
.build-title-row{display:flex;justify-content:space-between;align-items:flex-start;flex-wrap:wrap;gap:12px}
.build-name-big{font-size:22px;font-weight:700}
.tier-badge{display:inline-block;padding:5px 12px;background:var(--grad);border-radius:20px;font-size:11px;font-weight:600;text-transform:uppercase;margin-top:4px}
.build-price-big{font-size:28px;font-weight:800;color:var(--green)}
.build-body{padding:22px 26px}

.comp-table{width:100%;border-collapse:collapse}
.comp-table th,.comp-table td{padding:12px 14px;text-align:left;border-bottom:1px solid var(--border)}
.comp-table th{color:var(--muted);font-weight:500;font-size:11px;text-transform:uppercase;letter-spacing:.5px}
.comp-table td{font-size:13px}
.comp-name{font-weight:500}
.comp-detail{color:var(--text2);font-size:11px}
.comp-price{color:var(--green);font-weight:600}

.bn-indicator{display:flex;align-items:center;gap:10px;padding:14px;background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.3);border-radius:11px;margin-top:20px}
.bn-indicator.warn{background:rgba(245,158,11,.1);border-color:rgba(245,158,11,.3)}
.bn-icon{font-size:20px}
.bn-text{font-size:13px;color:var(--text2)}
.bn-text strong{display:block;margin-bottom:2px;color:var(--text)}

.fps-section{margin-top:26px}
.fps-section h3{font-size:16px;font-weight:600;margin-bottom:14px}
.fps-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px}
.fps-card{background:rgba(15,23,42,.5);border:1px solid var(--border);border-radius:11px;padding:14px}
.fps-game{font-weight:600;margin-bottom:10px;font-size:13px}
.fps-row{display:flex;justify-content:space-between;align-items:center;padding:5px 0;font-size:12px}
.fps-res{color:var(--text2)}
.fps-val{font-weight:600}
.fps-val.excellent{color:var(--green)}
.fps-val.good{color:var(--cyan)}
.fps-val.ok{color:var(--yellow)}
.fps-val.low{color:var(--red)}

.upgrades{margin-top:24px}
.upgrades h3{font-size:16px;font-weight:600;margin-bottom:12px}
.upgrades ul{padding-left:18px}
.upgrades li{color:var(--text2);font-size:13px;margin-bottom:6px}

/* ── BOTTLENECK ──────────────────────────────────────────────── */
.bn-container{max-width:860px;margin:0 auto;padding:36px 24px}
.selector-card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:28px;margin-bottom:24px}
.selector-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.sel-group label{display:block;font-weight:600;margin-bottom:10px}
.combobox-wrap{position:relative}
.combobox-input{width:100%;padding:12px 14px;background:var(--bg2);border:1px solid var(--border);border-radius:11px;color:var(--text);font-size:13px;cursor:pointer;outline:none;transition:border-color .2s;font-family:inherit}
.combobox-input:focus{border-color:var(--blue)}
.combobox-dropdown{display:none;position:absolute;top:calc(100% + 4px);left:0;right:0;background:var(--bg2);border:1px solid var(--border);border-radius:11px;max-height:240px;overflow-y:auto;z-index:100;box-shadow:0 10px 30px rgba(0,0,0,.4)}
.combobox-dropdown.open{display:block}
.combo-search{padding:10px;border-bottom:1px solid var(--border);position:sticky;top:0;background:var(--bg2)}
.combo-search input{width:100%;background:rgba(59,130,246,.08);border:1px solid var(--border);border-radius:7px;padding:8px 12px;color:var(--text);font-size:12px;outline:none;font-family:inherit}
.combo-option{padding:9px 14px;cursor:pointer;font-size:12px;transition:background .15s;border-bottom:1px solid rgba(59,130,246,.06)}
.combo-option:hover,.combo-option.selected{background:rgba(59,130,246,.1);color:var(--blue)}
.combo-group-label{padding:7px 14px;font-size:10px;font-weight:700;text-transform:uppercase;color:var(--muted);background:rgba(0,0,0,.2);letter-spacing:.6px}

.mode-row{display:flex;gap:10px;justify-content:center;margin-top:20px;flex-wrap:wrap}
.mode-btn{padding:10px 20px;background:rgba(59,130,246,.08);border:1px solid var(--border);border-radius:9px;color:var(--text2);font-weight:500;font-size:13px;cursor:pointer;transition:all .25s;font-family:inherit}
.mode-btn:hover{border-color:rgba(59,130,246,.4)}
.mode-btn.active{background:var(--grad);color:#fff;border-color:transparent}

.res-tabs{display:flex;gap:8px;justify-content:center;margin-top:12px;flex-wrap:wrap}
.res-tab{padding:7px 16px;background:rgba(59,130,246,.08);border:1px solid var(--border);border-radius:7px;cursor:pointer;font-size:12px;font-weight:500;color:var(--text2);transition:all .25s;font-family:inherit}
.res-tab:hover{border-color:rgba(59,130,246,.4)}
.res-tab.active{background:var(--grad);color:#fff;border-color:transparent}

.bn-results{display:none}
.bn-results.active{display:block}
.meter-card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:36px;text-align:center;margin-bottom:20px}
.meter-wrap{position:relative;width:200px;height:200px;margin:0 auto 20px}
.meter-svg{transform:rotate(-90deg)}
.meter-bg{fill:none;stroke:rgba(59,130,246,.1);stroke-width:12}
.meter-fill{fill:none;stroke-width:12;stroke-linecap:round;transition:stroke-dashoffset 1s ease,stroke .5s ease}
.meter-val{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center}
.meter-pct{font-size:44px;font-weight:800;background:var(--grad);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.meter-lbl{font-size:13px;color:var(--text2)}
.bn-status{font-size:18px;font-weight:600;margin-bottom:6px}
.bn-desc{color:var(--text2);font-size:14px;max-width:500px;margin:0 auto}

.util-card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:26px;margin-bottom:20px}
.util-card h3{font-size:16px;font-weight:600;margin-bottom:20px}
.util-bar-wrap{margin-bottom:18px}
.util-bar-head{display:flex;justify-content:space-between;margin-bottom:7px;font-size:13px}
.util-bar-label{font-weight:500}
.util-bar-val{font-weight:600}
.util-track{height:9px;background:rgba(59,130,246,.1);border-radius:5px;overflow:hidden}
.util-fill{height:100%;border-radius:5px;transition:width 1.2s ease}
.util-fill.cpu{background:linear-gradient(90deg,var(--blue),var(--cyan))}
.util-fill.gpu{background:linear-gradient(90deg,var(--purple),var(--blue))}

.res-table-card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:26px;margin-bottom:20px}
.res-table-card h3{font-size:16px;font-weight:600;margin-bottom:16px}
.res-table{width:100%;border-collapse:collapse;font-size:13px}
.res-table th,.res-table td{padding:10px 14px;text-align:center;border-bottom:1px solid var(--border)}
.res-table th{color:var(--muted);font-size:11px;text-transform:uppercase}
.res-table td:first-child{text-align:left;font-weight:500}
.pct-good{color:var(--green)}
.pct-ok{color:var(--yellow)}
.pct-warn{color:var(--red)}

.recs-card{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:26px}
.recs-card h3{font-size:16px;font-weight:600;margin-bottom:14px}
.rec-item{display:flex;align-items:flex-start;gap:10px;padding:13px;background:rgba(16,185,129,.08);border:1px solid rgba(16,185,129,.18);border-radius:10px;margin-bottom:10px}
.rec-item.warn{background:rgba(245,158,11,.08);border-color:rgba(245,158,11,.18)}
.rec-text{font-size:13px;color:var(--text2)}
.rec-text strong{color:var(--text);display:block;margin-bottom:2px}

/* ── COMPARE ─────────────────────────────────────────────────── */
.compare-container{max-width:1100px;margin:0 auto;padding:36px 24px}
.tab-row{display:flex;gap:8px;margin-bottom:28px;border-bottom:1px solid var(--border);padding-bottom:0}
.tab-btn{padding:11px 24px;background:none;border:none;border-bottom:2px solid transparent;color:var(--text2);font-weight:500;font-size:14px;cursor:pointer;margin-bottom:-1px;transition:all .2s;font-family:inherit}
.tab-btn.active{color:var(--blue);border-bottom-color:var(--blue)}
.tab-content{display:none}
.tab-content.active{display:block}

.compare-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:24px}
.compare-sel{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:20px}
.compare-sel h3{font-size:14px;font-weight:600;margin-bottom:12px;color:var(--text2)}

.compare-result{background:var(--card);border:1px solid var(--border);border-radius:20px;padding:26px;margin-bottom:20px}
.compare-result h3{font-size:16px;font-weight:600;margin-bottom:20px}
.stat-row{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.stat-name{width:130px;font-size:12px;color:var(--text2);flex-shrink:0}
.stat-bars{flex:1;display:flex;flex-direction:column;gap:6px}
.stat-bar-wrap{display:flex;align-items:center;gap:8px}
.stat-bar-bg{flex:1;height:8px;background:rgba(59,130,246,.1);border-radius:4px;overflow:hidden}
.stat-bar-fill{height:100%;border-radius:4px;transition:width .8s ease}
.stat-bar-fill.a{background:linear-gradient(90deg,var(--blue),var(--cyan))}
.stat-bar-fill.b{background:linear-gradient(90deg,var(--purple),var(--blue))}
.stat-val{width:36px;font-size:12px;font-weight:600;text-align:right}
.winner-badge{padding:2px 8px;border-radius:12px;font-size:10px;font-weight:700;background:rgba(16,185,129,.2);color:var(--green);white-space:nowrap}

.specs-compare{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}
.spec-box{background:rgba(15,23,42,.5);border:1px solid var(--border);border-radius:11px;padding:14px}
.spec-box h4{font-size:12px;font-weight:700;color:var(--blue);margin-bottom:10px}
.spec-row{display:flex;justify-content:space-between;font-size:12px;padding:4px 0;border-bottom:1px solid rgba(59,130,246,.06)}
.spec-row:last-child{border-bottom:none}
.spec-label{color:var(--text2)}
.spec-val{font-weight:500}

/* ── ABOUT ───────────────────────────────────────────────────── */
.about-container{max-width:860px;margin:0 auto;padding:56px 24px}
.about-header{text-align:center;margin-bottom:44px}
.about-avatar{width:110px;height:110px;background:var(--grad);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:40px;font-weight:800;margin:0 auto 20px;box-shadow:0 0 36px rgba(59,130,246,.4)}
.about-section{background:var(--card);border:1px solid var(--border);border-radius:18px;padding:28px;margin-bottom:20px}
.about-section h2{font-size:18px;font-weight:600;margin-bottom:13px;display:flex;align-items:center;gap:10px}
.about-section p{color:var(--text2);line-height:1.8;font-size:14px}
.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:20px}
.disclaimer{background:rgba(245,158,11,.08);border:1px solid rgba(245,158,11,.25);border-radius:14px;padding:20px;margin-top:32px}
.disclaimer h3{color:var(--yellow);font-size:14px;margin-bottom:8px}
.disclaimer p{color:rgba(245,158,11,.7);font-size:13px}

/* ── FOOTER ──────────────────────────────────────────────────── */
footer{background:var(--bg2);border-top:1px solid var(--border);padding:36px 24px;margin-top:56px}
.footer-inner{max-width:1200px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px}
.footer-brand{display:flex;align-items:center;gap:10px}
.footer-logo{width:32px;height:32px;background:var(--grad);border-radius:7px;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px}
.footer-text{color:var(--muted);font-size:13px}
.footer-links{display:flex;gap:20px}
.footer-links a{color:var(--text2);text-decoration:none;font-size:13px;cursor:pointer;transition:color .2s}
